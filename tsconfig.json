{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {"@/*": ["editor/src/*"]}
  },
  "include": ["src", "pipeline", "tests", "editor/src", "editor/vite.config.ts", "remotion.config.ts"]
}
