# Copy to .env (or export in your shell). Never commit the real key.
OMNIROUTE_API_KEY=
# OMNIROUTE_BASE_URL=https://api.h93lab.com/v1
# Override any role with a comma-separated fallback list of OmniRoute model ids:
# MOTION_DIRECTOR=antigravity/gemini-3.1-pro-high,mimotp/mimo-v2.5-pro
# MOTION_WRITER=ds/deepseek-flash,mimotp/mimo-v2.5-pro
# MOTION_VISION=antigravity/gemini-3.1-pro-high
# MOTION_IMAGE=antigravity/gemini-3.1-flash-image
# MOTION_STT=groq/whisper-large-v3
# Narrator: empty = free Azure/Edge voice picked from dialect + gender. Any Edge voice (ar-EG-SalmaNeural…) or an ElevenLabs voice id.
# MOTION_VOICE=
# MOTION_VOICE_RATE=+6%
# MOTION_TTS_MODEL=elevenlabs/eleven_multilingual_v2
# Generated b-roll (opt-in; needs a gateway path without Cloudflare's 100s limit):
# MOTION_VIDEO=veo-free/veo,veo-free/seedance
# Optional: Jev as a second judge in `npm run bench`
# TYPESAFE_API_KEY=
