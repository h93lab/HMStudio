{
  "name": "motion-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "render": "tsx pipeline/cli.ts render",
    "typecheck": "tsc --noEmit",
    "make": "tsx pipeline/cli.ts make",
    "revise": "tsx pipeline/cli.ts revise",
    "reformat": "tsx pipeline/cli.ts reformat",
    "cost": "tsx pipeline/cli.ts cost",
    "clients": "tsx pipeline/cli.ts clients",
    "bench": "tsx pipeline/cli.ts bench",
    "audio": "python3 scripts/make-audio.py",
    "test": "tsx --test tests/*.test.ts",
    "batch": "tsx pipeline/cli.ts batch",
    "dashboard": "tsx pipeline/server.ts",
    "editor": "vite build --config editor/vite.config.ts",
    "editor:dev": "vite --config editor/vite.config.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/layout-utils": "4.0.534",
    "@remotion/media-parser": "4.0.534",
    "@remotion/noise": "4.0.534",
    "@remotion/player": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "@remotion/zod-types": "4.0.534",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.54.0",
    "msedge-tts": "2.0.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
